{
  "name": "@adonisjs/lucid-slugify",
  "description": "Generate and persist unique slugs in your database via Lucid models",
  "version": "3.0.0-beta.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./strategies": "./build/src/strategies/main.js"
  },
  "scripts": {
    "pretest": "npm run lint && rm -rf coverage/tmp && mkdir -p coverage/tmp",
    "posttest": "cp -r coverage/*/tmp/. coverage/tmp && c8 report",
    "test": "npm run test:sqlite && npm run test:pg && npm run test:mysql && npm run test:legacy_mysql && npm run test:mssql",
    "test:mysql": "cross-env NODE_DEBUG=\"adonisjs:lucid-slugify\" DB=mysql c8 --report-dir coverage/mysql npm run test:run",
    "test:legacy_mysql": "cross-env NODE_DEBUG=\"adonisjs:lucid-slugify\" DB=legacy_mysql c8 --report-dir coverage/legacy_mysql npm run test:run",
    "test:mssql": "cross-env NODE_DEBUG=\"adonisjs:lucid-slugify\" DB=mssql c8 --report-dir coverage/mssql npm run test:run",
    "test:sqlite": "cross-env NODE_DEBUG=\"adonisjs:lucid-slugify\" DB=sqlite c8 --report-dir coverage/sqlite npm run test:run",
    "test:pg": "cross-env NODE_DEBUG=\"adonisjs:lucid-slugify\" DB=pg c8 --report-dir coverage/pg npm run test:run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "test:run": "node --import=ts-node-maintained/register/esm --enable-source-maps bin/test.ts",
    "quick:test": "DB=sqlite c8 node --import=ts-node-maintained/register/esm --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/core": "^6.17.2",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/lucid": "^21.6.0",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/assert": "^4.0.1",
    "@japa/expect": "^3.0.3",
    "@japa/expect-type": "^2.0.3",
    "@japa/file-system": "^2.3.2",
    "@japa/runner": "^4.2.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@swc/core": "1.10.7",
    "@types/node": "^22.13.9",
    "better-sqlite3": "^11.8.1",
    "c8": "^10.1.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.13.0",
    "pg": "^8.13.3",
    "prettier": "^3.5.3",
    "release-it": "^18.1.2",
    "tedious": "^18.6.1",
    "ts-node-maintained": "^10.9.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.17.2",
    "@adonisjs/lucid": "^21.6.0"
  },
  "homepage": "https://github.com/adonisjs/lucid-slugify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/lucid-slugify.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/lucid-slugify/issues"
  },
  "keywords": [
    "lucid",
    "slug",
    "unique-slugs"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsup": {
    "entry": [
      "index.ts",
      "src/types.ts",
      "src/strategies/main.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "dependencies": {
    "nanoid": "^5.1.3"
  }
}
